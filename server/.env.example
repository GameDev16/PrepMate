PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prepmate
JWT_SECRET=super-secret-jwt-key-change-in-production

# AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
MOCK_MODE=false

# Credits & Payments
UNLIMITED_CREDIT_EMAILS=parth@prepmate.ai
# Leave RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET blank to run in mock-payment mode
# (fake orders, no real charge, no Razorpay account needed for local dev).
# Fill both in with real keys from your Razorpay Dashboard to accept real
# payments — see the Razorpay setup guide for the exact steps.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password reset email (Optional)
# Leave RESEND_API_KEY blank to fall back to logging the reset link to the
# server console instead of emailing it — fine for local dev. Get a free
# key at https://resend.com to send real reset emails.
RESEND_API_KEY=
FROM_EMAIL=PrepMate <onboarding@resend.dev>

# Dev-only: echoes the raw password-reset token back in the API response
# body so ForgotPasswordPage can render a clickable link without a real
# mail provider configured. Leave unset/false outside local development —
# if this were ever true in production it lets anyone reset any account's
# password just by knowing their email address.
EXPOSE_RESET_TOKENS=false

